#!/bin/sh
# 推送前安全门禁：扫描密钥与个人信息（--strict），命中即阻止推送。
# 说明：git 钩子不随 clone / 复制分发，需在项目初始化时执行
#   git config core.hooksPath .githooks 启用本钩子。

repo="$(git rev-parse --show-toplevel)" || exit 1
cd "$repo" || exit 1

[ -f scripts/scan_secrets.py ] || {
    echo "[pre-push] 跳过：scripts/scan_secrets.py 不存在" >&2
    exit 0
}

# 探测可用的 Python 解释器
if command -v python3 >/dev/null 2>&1; then
    PY=python3
elif command -v python >/dev/null 2>&1; then
    PY=python
elif command -v py >/dev/null 2>&1; then
    PY="py -3"
else
    echo "[pre-push] 警告：未找到 Python 解释器，跳过本地扫描" >&2
    exit 0
fi

$PY scripts/scan_secrets.py --strict
rc=$?
if [ $rc -ne 0 ]; then
    echo "[pre-push] 安全扫描未通过，已阻止推送（临时绕过：git push --no-verify）" >&2
    exit 1
fi
echo "[pre-push] 安全扫描通过"
exit 0
