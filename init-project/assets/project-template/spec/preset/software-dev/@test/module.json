{
  "id": "test",
  "name": "测试与验收",
  "version": "0.1.0",
  "description": "生成测试用例并按照用例进行测试",

  "input": [
    "开发产物（development）",
    "验收标准（PRD）",
    "接口契约（design）"
  ],

  "output": [
    "测试用例（TEST-0001.md，每期一份）+ 测试报告（测完归档）"
  ],

  "depends_on": ["development", "prd", "design"],

  "workspace": {
    "test": "context/test/"
  },

  "enable": {
    "instantiate": ["context/test/"]
  },

  "disable": {
    "keep": ["context/test/"]
  }
}
