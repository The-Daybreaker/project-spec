# Normalize line endings; keep text files LF for cross-platform consistency
# (including Windows scripts, matching .editorconfig end_of_line = lf).
* text=auto

*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ps1 text eol=lf
*.bat text eol=lf
